class Solution {
    public int[] twoSum(int[] nums, int target) {
        
        int n =  nums.length ;
        int[] result = new int[2] ;

        HashMap<Integer,Integer> map = new HashMap<>() ;
        map.put(nums[0] , 0) ;


        for(int i = 1 ; i < n ; i++)
        {
            if(map.containsKey(target - nums[i]))
            {
                result[0] = map.get(target - nums[i]) ;
                result[1] = i ;
            }

            map.put(nums[i] , i ) ;
        }

        return result ;
    }
}
